{
  "build": {
    "beforeDevCommand": "node scripts/frontend.mjs dev",
    "beforeBuildCommand": "node scripts/frontend.mjs build",
    "frontendDist": "frontend/dist",
    "devUrl": "http://localhost:5173"
  },
  "bundle": {
    "active": true,
    "windows": {
      "wix": { "version": "0.3.1.1" }
    },
    "targets": [
      "nsis",
      "msi"
    ],
    "externalBin": [
      "bin/adb",
      "bin/steamvr-brightness-helper"
    ],
    "resources": {
      "LICENSES/*": "LICENSES/",
      "LICENSE": "",
      "bin/*.dll": ""
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "productName": "pico4u-vr-sleep-workaround",
  "version": "0.3.1-rc1",
  "identifier": "com.tauri.pico4uvrsleepworkaround",
  "plugins": {},
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "pico4u-vr-sleep-workaround",
        "width": 1120,
        "height": 840,
        "minWidth": 640,
        "minHeight": 560,
        "decorations": true,
        "shadow": true
      }
    ],
    "security": {
      "freezePrototype": false,
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  }
}
